# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is in .gitignore, so your secrets never reach GitHub.
# On Render, you type these same keys into Environment settings.
# ─────────────────────────────────────────────────────────────

# 1) Postgres connection string from Neon (Dashboard → Connect → copy)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 2) A long random string used to sign login cookies.
#    Generate one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# 3) OPTIONAL: Google OAuth Client ID (ends with .apps.googleusercontent.com)
#    Leave empty and the app still works with "Continue as guest".
GOOGLE_CLIENT_ID=

# 4) Port for local development (Render sets this automatically)
PORT=3000
